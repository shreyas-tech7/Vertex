{
  "name": "vertex-calculator",
  "version": "0.1.0",
  "private": true,
  "description": "Vertex, a free TI-84 Plus CE calculator for the browser. Runs the real TI-OS on CEmu (WebAssembly) with a ROM from the visitor's own calculator.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run scan",
    "test:e2e": "vite build && playwright test",
    "gen:pages": "node scripts/generate-pages.ts",
    "build:emulator": "bash emulator/build.sh",
    "scan": "node scripts/scan-forbidden.mjs",
    "assets": "node scripts/make-assets.mjs",
    "compare": "node scripts/compare-reference.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
